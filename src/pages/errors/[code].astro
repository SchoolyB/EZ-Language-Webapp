---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import errorDocs from '../../data/error-docs.json';

const ERRORS_URL = 'https://raw.githubusercontent.com/SchoolyB/EZ/main/ERRORS.md';

export async function getStaticPaths() {
  const response = await fetch('https://raw.githubusercontent.com/SchoolyB/EZ/main/ERRORS.md');
  if (!response.ok) throw new Error(`Failed to fetch ERRORS.md: ${response.status}`);
  const markdown = await response.text();

  const lines = markdown.split('\n');
  const allErrors: any[] = [];
  let currentCategory: any = null;
  let inTable = false;

  function getCategoryName(header: string): string {
    const h = header.toLowerCase();
    if (h.includes('lexer')) return 'Lexer Errors';
    if (h.includes('parse')) return 'Parse Errors';
    if (h.includes('type error')) return 'Type Errors';
    if (h.includes('reference')) return 'Reference Errors';
    if (h.includes('runtime')) return 'Runtime Errors';
    if (h.includes('import')) return 'Import Errors';
    if (h.includes('stdlib')) return 'Stdlib Errors';
    if (h.includes('math')) return 'Math Errors';
    if (h.includes('array')) return 'Array Errors';
    if (h.includes('string error')) return 'String Errors';
    if (h.includes('time')) return 'Time Errors';
    if (h.includes('map')) return 'Map Errors';
    if (h.includes('json')) return 'JSON Errors';
    if (h.includes('csv')) return 'CSV Errors';
    if (h.includes('regex')) return 'Regex Errors';
    if (h.includes('code style')) return 'Code Style Warnings';
    if (h.includes('potential bug')) return 'Potential Bug Warnings';
    if (h.includes('code quality')) return 'Code Quality Warnings';
    if (h.includes('module warning')) return 'Module Warnings';
    return 'Unknown';
  }

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();

    const headerMatch = line.match(/^## (.+?) \(([EW]\d+x+(?:-[EW]\d+x+)?)\)$/);
    if (headerMatch) {
      currentCategory = { name: getCategoryName(headerMatch[1]) };
      inTable = false;
      continue;
    }

    if (line.startsWith('| Code |')) { inTable = true; continue; }
    if (line.startsWith('|---')) continue;

    if (inTable && line.startsWith('|') && currentCategory) {
      const cells = line.split('|').map(c => c.trim()).filter(c => c);
      if (cells.length >= 3) {
        const [code, slug, message] = cells;
        if (code.match(/^[EW]\d+$/)) {
          allErrors.push({ code, slug, message, categoryName: currentCategory.name });
        }
      }
    }

    if (inTable && !line.startsWith('|') && line !== '') {
      inTable = false;
    }
  }

  return allErrors.map((error, index) => ({
    params: { code: error.code },
    props: {
      error,
      prevError: index > 0 ? allErrors[index - 1] : null,
      nextError: index < allErrors.length - 1 ? allErrors[index + 1] : null,
    }
  }));
}

const { code } = Astro.params;
const { error, prevError, nextError } = Astro.props;
const base = import.meta.env.BASE_URL;

// Get enriched docs if available
const errorDoc = (errorDocs as any).errors.find((e: any) => e.code === code);

const isWarning = code!.startsWith('W');

function formatSlug(slug: string): string {
  return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

const title = formatSlug(error.slug);
const usedFor = errorDoc?.usedFor || `This error is triggered when: ${error.message.toLowerCase()}`;
const example = errorDoc?.example || error.message;
const howToFix = errorDoc?.howToFix || 'Review the error message and check your code at the indicated location. The message describes what went wrong — fix the underlying issue it identifies.';
const relatedErrors = errorDoc?.relatedErrors || [];
const suppressible = errorDoc?.suppressible || null;
---

<BaseLayout title={`${code} - EZ Errors`}>
  <Header />

  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm">
        <ol class="flex items-center gap-2 opacity-60">
          <li><a href={base} class="hover:opacity-100">Home</a></li>
          <li>/</li>
          <li><a href={`${base}errors`} class="hover:opacity-100">Errors</a></li>
          <li>/</li>
          <li class="opacity-100 font-medium">{code}</li>
        </ol>
      </nav>

      <!-- Content -->
      <div>
        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class:list={[
              'px-3 py-1 rounded-full text-sm font-mono font-semibold',
              isWarning
                ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
                : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
            ]}>
              {code}
            </span>
            <span class="text-sm opacity-60">{error.categoryName}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-black dark:text-white">{title}</h1>
          <p class="text-xl opacity-70">{error.message}</p>
        </header>

        <!-- Main content -->
        <div class="space-y-8">
          <!-- When this occurs -->
          <section>
            <h2 class="text-xl font-semibold mb-3 text-black dark:text-white">When this occurs</h2>
            <p class="opacity-80">{usedFor}</p>
          </section>

          <!-- Example message -->
          <section>
            <h2 class="text-xl font-semibold mb-3 text-black dark:text-white">Example error message</h2>
            <div class="bg-[#f5f5f5] dark:bg-[#1a1a1a] border border-[#e5e5e5] dark:border-[#333333] rounded-lg p-4 font-mono text-sm">
              <span class:list={[
                'font-semibold',
                isWarning ? 'text-yellow-600 dark:text-yellow-400' : 'text-red-600 dark:text-red-400'
              ]}>
                {isWarning ? 'warning' : 'error'}[{code}]:
              </span>
              <span class="opacity-80"> {example}</span>
            </div>
          </section>

          <!-- Suppressible warning -->
          {suppressible && (
            <section>
              <h2 class="text-xl font-semibold mb-3 text-black dark:text-white">Suppressing this warning</h2>
              <p class="opacity-80 mb-3">This warning can be suppressed using:</p>
              <code class="bg-[#f5f5f5] dark:bg-[#1a1a1a] px-3 py-1.5 rounded border border-[#e5e5e5] dark:border-[#333333] font-mono text-sm">{suppressible}</code>
            </section>
          )}

          <!-- How to fix -->
          <section class="border-t border-[#e5e5e5] dark:border-[#333333] pt-8">
            <h2 class="text-xl font-semibold mb-3 text-black dark:text-white">How to fix</h2>
            <p class="opacity-80">{howToFix}</p>
          </section>

          <!-- Related errors -->
          <section class="border-t border-[#e5e5e5] dark:border-[#333333] pt-8">
            <h2 class="text-xl font-semibold mb-3 text-black dark:text-white">Related errors</h2>
            {relatedErrors.length > 0 ? (
              <div class="flex flex-wrap gap-2">
                {relatedErrors.map((relatedCode: string) => (
                  <a href={`${base}errors/${relatedCode}`} class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#f5f5f5] dark:bg-[#1a1a1a] border border-[#e5e5e5] dark:border-[#333333] rounded-lg hover:border-black dark:hover:border-white transition-colors">
                    <span class="font-mono text-sm font-medium">{relatedCode}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="opacity-60 italic">No related errors.</p>
            )}
          </section>
        </div>

        <!-- Navigation -->
        <nav class="mt-12 pt-8 border-t border-[#e5e5e5] dark:border-[#333333]">
          <div class="flex justify-between">
            {prevError ? (
              <a href={`${base}errors/${prevError.code}`} class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                <span class="text-sm">
                  <span class="font-mono">{prevError.code}</span>
                  <span class="hidden sm:inline opacity-60 ml-1">- {formatSlug(prevError.slug)}</span>
                </span>
              </a>
            ) : <div />}
            {nextError ? (
              <a href={`${base}errors/${nextError.code}`} class="flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
                <span class="text-sm">
                  <span class="font-mono">{nextError.code}</span>
                  <span class="hidden sm:inline opacity-60 ml-1">- {formatSlug(nextError.slug)}</span>
                </span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <div />}
          </div>
        </nav>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
